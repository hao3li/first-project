<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeNavy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/theme_navy"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/brand_navy"
            app:cornerRadius="36dp"
            app:strokeColor="@color/brand_navy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeGreen"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/theme_green"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/theme_green_primary"
            app:cornerRadius="36dp"
            app:strokeColor="@color/theme_green_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemePurple"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/theme_purple"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/theme_purple_primary"
            app:cornerRadius="36dp"
            app:strokeColor="@color/theme_purple_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemePink"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/theme_pink"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/theme_pink_primary"
            app:cornerRadius="36dp"
            app:strokeColor="@color/theme_pink_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeSkyBlue"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/theme_skyblue"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/theme_skyblue_primary"
            app:cornerRadius="36dp"
            app:strokeColor="@color/theme_skyblue_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeYellow"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/theme_yellow"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/theme_yellow_primary"
            app:cornerRadius="36dp"
            app:strokeColor="@color/theme_yellow_primary" />
    </LinearLayout>
</LinearLayout>
